// Kinvo — complete database schema.
//
// Written in one pass (spec §7, Batch 1) so later batches never fight the schema.
// Read KINVO_BACKEND_BUILD.md before changing anything here.
//
// THE RULE THAT SHAPES EVERYTHING: mode scoping.
// Kinvo is eight parallel social graphs sharing one user table. Mode is part of
// the identity of a swipe, a match, and a conversation — never a filter bolted
// on afterwards. See the Swipe and Match models for where that is enforced.
//
// PostGIS: Prisma cannot type a `geography` column, so location fields are
// declared Unsupported(). They cannot be read or written through Prisma Client —
// every radius query goes through $queryRaw in src/db/geo.ts (permitted by
// spec §0.5). GIST indexes, CHECK constraints, and partial unique indexes are
// added by hand in the migration SQL for the same reason.

generator client {
  provider = "prisma-client"
  // Inside src/ so the compiler's rootDir covers it. Git-ignored and
  // regenerated by `npm run db:generate` (and automatically on install).
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS  (spec §4.6: lowercase snake_case strings, never integers)
// ============================================================================

/// The eight connection modes. Adding one is a migration plus a /config change,
/// never new endpoints — the deck actions below are deliberately mode-blind.
enum Mode {
  dating
  study_buddy
  networking
  trading
  foodie
  cuddle
  pet_dates
  fitness

  @@map("mode")
}

/// spec §5.1: onboarding is a state machine, pending -> active. `suspended` and
/// `deleted` added because §4.4 needs ACCOUNT_SUSPENDED and Batch 3 needs
/// account deletion. Snooze is deliberately NOT a status — see User.is_snoozed.
enum UserStatus {
  pending
  active
  suspended
  deleted

  @@map("user_status")
}

enum UserRole {
  user
  moderator
  admin

  @@map("user_role")
}

/// spec §5.1: one user, many identities. Signing up with email then using Google
/// on the same address links to the existing user, never creates a second.
enum AuthProvider {
  email
  phone
  google
  apple

  @@map("auth_provider")
}

/// spec §1: always these three, in every mode. The mode changes only the label
/// the app renders, served from GET /config. Never add per-mode actions.
enum SwipeAction {
  pass
  like
  super_like

  @@map("swipe_action")
}

enum MatchStatus {
  active
  expired
  unmatched

  @@map("match_status")
}

enum MessageType {
  text
  image
  video
  voice_note
  venue_card

  @@map("message_type")
}

/// spec §4.8: media with `pending` is visible to its owner and nobody else.
enum ModerationStatus {
  pending
  approved
  rejected

  @@map("moderation_status")
}

enum ModerationSeverity {
  none
  low
  medium
  high
  critical

  @@map("moderation_severity")
}

enum VerificationMethod {
  photo
  government_id
  social

  @@map("verification_method")
}

enum VerificationStatus {
  pending
  approved
  rejected

  @@map("verification_status")
}

/// spec §5.7
enum ReportReason {
  harassment
  fake_profile
  spam_scam
  safety_concern

  @@map("report_reason")
}

enum ReportStatus {
  open
  under_review
  actioned
  dismissed

  @@map("report_status")
}

/// spec §5.8: draft -> proposed -> confirmed | declined | cancelled -> completed
enum PlanStatus {
  draft
  proposed
  confirmed
  declined
  cancelled
  completed

  @@map("plan_status")
}

/// spec §5.9
enum VenueCategory {
  cafe
  restaurant
  park
  gym
  study_spot
  pet_friendly
  romantic
  health_conscious

  @@map("venue_category")
}

enum SubscriptionTier {
  free
  basic
  advanced

  @@map("subscription_tier")
}

enum BillingCycle {
  monthly
  quarterly
  yearly

  @@map("billing_cycle")
}

/// spec §5.10: must cover the full store lifecycle, not just active/expired.
enum SubscriptionStatus {
  active
  in_grace_period
  on_billing_retry
  expired
  cancelled
  refunded
  revoked

  @@map("subscription_status")
}

/// spec §5.10: entitlement resolution must not care where the money came from.
enum PaymentSource {
  apple
  google

  @@map("payment_source")
}

/// Profile photos have their own table (read on every deck card). This covers
/// everything else. Verification documents live in a separate, stricter bucket
/// (spec §7, Batch 4) — they are the most sensitive data in the system.
enum MediaKind {
  profile_photo
  chat_image
  chat_video
  voice_note
  verification_document
  report_evidence

  @@map("media_kind")
}

/// spec §7 Batch 5: theme and accessibility are server-persisted so they follow
/// the user across devices rather than resetting on a reinstall.
enum ThemePreference {
  system
  light
  dark

  @@map("theme_preference")
}

enum DistanceUnit {
  miles
  kilometres

  @@map("distance_unit")
}

enum DevicePlatform {
  ios
  android
  web

  @@map("device_platform")
}

enum NotificationCategory {
  new_match
  new_like
  new_message
  plan_update
  call
  verification
  safety
  moderation
  subscription
  system

  @@map("notification_category")
}

enum CallStatus {
  ringing
  active
  ended
  missed
  declined
  failed

  @@map("call_status")
}

enum CallSafetyActionType {
  flag
  end_and_report
  send_live_update

  @@map("call_safety_action_type")
}

enum EmergencyEventType {
  help_requested
  location_shared
  check_in_missed

  @@map("emergency_event_type")
}

// --- Lifestyle (spec §7, Batch 3) --------------------------------------------
// Enums rather than free text so Batch 7's advanced filters can index them.

enum Frequency {
  never
  rarely
  socially
  regularly
  prefer_not_to_say

  @@map("frequency")
}

enum ExerciseFrequency {
  never
  sometimes
  often
  daily
  prefer_not_to_say

  @@map("exercise_frequency")
}

enum Diet {
  omnivore
  vegetarian
  vegan
  pescatarian
  halal
  kosher
  other
  prefer_not_to_say

  @@map("diet")
}

enum PetSituation {
  none
  dog
  cat
  other
  multiple
  prefer_not_to_say

  @@map("pet_situation")
}

enum ChildrenPreference {
  none
  have_children
  want_children
  do_not_want_children
  open
  prefer_not_to_say

  @@map("children_preference")
}

enum EducationLevel {
  high_school
  undergraduate
  postgraduate
  doctorate
  other
  prefer_not_to_say

  @@map("education_level")
}

// ============================================================================
// IDENTITY
// ============================================================================

model User {
  id String @id @default(uuid(4)) @db.Uuid

  /// spec §4.7: part of user_compact, so it lives here rather than on Profile —
  /// one table read serves a deck card.
  display_name String @db.VarChar(50)

  /// spec §5.1: store date of birth, NEVER an age integer. Age is computed.
  ///
  /// Nullable because Google, Apple, and Twilio do not supply a date of birth,
  /// so a social or phone signup cannot know the user's age at the moment the
  /// account is created. The under-18 rejection therefore fires the instant a
  /// date of birth is set, and a user without one stays `pending` — blocked from
  /// discovery, matching, and chat with ONBOARDING_INCOMPLETE. Nobody under 18
  /// ever reaches the product, which is what §5.1 is actually protecting.
  /// Email registration still requires it up front.
  date_of_birth DateTime? @db.Date

  status            UserStatus       @default(pending)
  role              UserRole         @default(user)
  /// Batch 6 stub. Batch 13 switches entitlement resolution to real
  /// subscription data; this column stays as the fallback.
  subscription_tier SubscriptionTier @default(free)

  /// Derived from the latest approved Verification. Denormalised because it is
  /// both a hard filter (verified_only) and a ranking input on every deck.
  is_verified Boolean @default(false)

  /// spec §5.6: snooze hides the profile from all decks but the account stays
  /// active and existing matches survive — so it is a flag, not a status.
  /// The deck exclusion clause runs on every discovery query, so the hot path
  /// checks one boolean; a scheduled job clears the flag when the timer expires.
  is_snoozed     Boolean   @default(false)
  snooze_ends_at DateTime?

  last_active_at    DateTime  @default(now())
  onboarded_at      DateTime?
  suspended_at      DateTime?
  suspension_reason String?   @db.VarChar(500)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  /// spec §7 Batch 1: soft delete where audit matters. Production never hard
  /// deletes a user; cascades below exist for test teardown and GDPR erasure.
  deleted_at DateTime?

  profile                Profile?
  settings               UserSettings?
  auth_identities        AuthIdentity[]
  refresh_tokens         RefreshToken[]
  password_reset_tokens  PasswordResetToken[]
  devices                Device[]
  media_assets           MediaAsset[]
  verifications          Verification[]           @relation("VerificationSubject")
  verifications_reviewed Verification[]           @relation("VerificationReviewer")
  user_modes             UserMode[]
  swipes_made            Swipe[]                  @relation("SwipeActor")
  swipes_received        Swipe[]                  @relation("SwipeTarget")
  matches_as_a           Match[]                  @relation("MatchUserA")
  matches_as_b           Match[]                  @relation("MatchUserB")
  decks                  Deck[]
  deck_entries           DeckEntry[]              @relation("DeckEntryTarget")
  boosts                 Boost[]
  conversation_states    ConversationState[]
  messages               Message[]
  blocks_made            Block[]                  @relation("Blocker")
  blocks_received        Block[]                  @relation("Blocked")
  reports_made           Report[]                 @relation("Reporter")
  reports_received       Report[]                 @relation("Reported")
  reports_reviewed       Report[]                 @relation("ReportReviewer")
  trusted_contacts       TrustedContact[]
  live_locations         LiveLocationSession[]
  emergency_events       EmergencyEvent[]
  plans_created          Plan[]                   @relation("PlanCreator")
  availability_windows   AvailabilityWindow[]
  saved_venues           SavedVenue[]
  subscriptions          Subscription[]
  idempotency_keys       IdempotencyKey[]
  notifications          Notification[]
  notification_prefs     NotificationPreference[]
  calls_initiated        CallSession[]            @relation("CallInitiator")
  call_safety_actions    CallSafetyAction[]
  moderation_checks      ModerationCheck[]
  admin_audit_logs       AdminAuditLog[]

  @@index([status])
  @@index([deleted_at])
  @@index([last_active_at])
  @@index([is_snoozed])
  @@map("users")
}

model AuthIdentity {
  id       String       @id @default(uuid(4)) @db.Uuid
  user_id  String       @db.Uuid
  provider AuthProvider

  /// Email address, E.164 phone number, or the provider's subject identifier.
  identifier String @db.VarChar(320)

  /// argon2 hash. Only ever set for the `email` provider.
  password_hash String?

  verified_at DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  /// spec §5.1: the same identifier cannot belong to two users — this is what
  /// makes social login link rather than duplicate.
  @@unique([provider, identifier])
  @@index([user_id])
  @@map("auth_identities")
}

/// spec §4.3: refresh tokens rotate on every use. A replayed token revokes the
/// entire family, so `family_id` is the unit of revocation, not the row.
model RefreshToken {
  id         String  @id @default(uuid(4)) @db.Uuid
  user_id    String  @db.Uuid
  family_id  String  @db.Uuid
  token_hash String  @unique
  device_id  String? @db.VarChar(128)

  expires_at     DateTime
  revoked_at     DateTime?
  /// Set when this token is rotated. Presenting a token that has this populated
  /// is theft — revoke the whole family.
  replaced_by_id String?   @db.Uuid

  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([family_id])
  @@index([expires_at])
  @@map("refresh_tokens")
}

/// spec §7 Batch 2: single-use, one-hour expiry.
model PasswordResetToken {
  id      String @id @default(uuid(4)) @db.Uuid
  user_id String @db.Uuid

  /// sha256 of the six-digit code. Deliberately NOT unique: a code is only
  /// ever looked up alongside the account it belongs to, and two accounts
  /// holding the same six digits at the same time is ordinary, not a clash.
  token_hash String

  /// Wrong guesses against this code. Six digits are guessable in a way a
  /// 256-bit token never was, so the code dies after a handful of attempts
  /// (PASSWORD_RESET_MAX_ATTEMPTS) rather than living out its full hour.
  attempts Int @default(0)

  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("password_reset_tokens")
}

/// Connected devices list and revoke (spec §7, Batch 5) plus the FCM token
/// registration from Batch 11 — one row per install, not two tables.
model Device {
  id      String @id @default(uuid(4)) @db.Uuid
  user_id String @db.Uuid

  /// The X-Device-Id header (spec §4.11) — stable per install.
  device_id   String         @db.VarChar(128)
  platform    DevicePlatform
  app_version String?        @db.VarChar(32)
  os_version  String?        @db.VarChar(32)
  model       String?        @db.VarChar(64)

  /// Batch 11. Nullable until the app registers for push.
  fcm_token String?

  last_seen_at DateTime  @default(now())
  revoked_at   DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, device_id])
  @@index([user_id])
  @@index([fcm_token])
  @@map("devices")
}

// ============================================================================
// PROFILE
// ============================================================================

model Profile {
  id      String @id @default(uuid(4)) @db.Uuid
  user_id String @unique @db.Uuid

  bio          String?         @db.VarChar(500)
  job_title    String?         @db.VarChar(100)
  organisation String?         @db.VarChar(100)
  education    EducationLevel?
  height_cm    Int?

  /// PostGIS geography, SRID 4326. Prisma cannot read or write this column —
  /// see src/db/geo.ts. The GIST index is created in the migration by hand.
  /// Nullable: a user has no location until they grant permission.
  location            Unsupported("geography(Point, 4326)")?
  city                String?                                @db.VarChar(120)
  /// ISO 3166-1 alpha-2.
  country             String?                                @db.Char(2)
  location_updated_at DateTime?

  drinking Frequency?
  smoking  Frequency?
  exercise ExerciseFrequency?
  diet     Diet?
  pets     PetSituation?
  children ChildrenPreference?

  /// spec §7 Batch 3: profile completion percentage, recomputed on write.
  completion_percentage Int @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user      User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  photos    Photo[]
  interests ProfileInterest[]
  answers   ProfileAnswer[]

  @@index([city])
  @@map("profiles")
}

/// Seeded catalogue, served by GET /config so adding an interest needs no app
/// release (spec §4.12).
model Interest {
  id         String  @id @default(uuid(4)) @db.Uuid
  slug       String  @unique @db.VarChar(64)
  label      String  @db.VarChar(64)
  category   String  @db.VarChar(64)
  /// Which modes surface this interest. Trading's instrument tags are exactly
  /// this and nothing more (spec §1).
  modes      Mode[]
  is_active  Boolean @default(true)
  sort_order Int     @default(0)

  profiles ProfileInterest[]

  @@index([category])
  @@map("interests")
}

model ProfileInterest {
  profile_id  String   @db.Uuid
  interest_id String   @db.Uuid
  created_at  DateTime @default(now())

  profile  Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interest_id], references: [id], onDelete: Cascade)

  @@id([profile_id, interest_id])
  @@index([interest_id])
  @@map("profile_interests")
}

/// Seeded catalogue, served by GET /config (spec §4.12).
model PromptQuestion {
  id         String  @id @default(uuid(4)) @db.Uuid
  slug       String  @unique @db.VarChar(64)
  question   String  @db.VarChar(200)
  modes      Mode[]
  is_active  Boolean @default(true)
  sort_order Int     @default(0)

  answers ProfileAnswer[]

  @@map("prompt_questions")
}

model ProfileAnswer {
  id          String @id @default(uuid(4)) @db.Uuid
  profile_id  String @db.Uuid
  question_id String @db.Uuid
  answer      String @db.VarChar(300)
  position    Int    @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  profile  Profile        @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  question PromptQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@unique([profile_id, question_id])
  @@index([profile_id])
  @@map("profile_answers")
}

// ============================================================================
// MEDIA AND VERIFICATION
// ============================================================================

/// Profile photos are their own table rather than rows in MediaAsset: they are
/// read on every deck card and every list, and a join through a generic asset
/// table would be a self-inflicted N+1 (spec §4.7).
/// Max 6 per profile (spec §7, Batch 4) — enforced in the service layer.
model Photo {
  id         String @id @default(uuid(4)) @db.Uuid
  profile_id String @db.Uuid

  s3_bucket String @db.VarChar(128)
  s3_key    String @db.VarChar(512)
  url       String @db.VarChar(2048)

  position   Int
  is_primary Boolean @default(false)

  width      Int?
  height     Int?
  size_bytes Int?

  /// spec §4.8: pending media is visible to its owner and nobody else.
  moderation_status ModerationStatus @default(pending)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  profile Profile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  // Uniqueness of (profile_id, position) and of the primary photo is enforced
  // by partial unique indexes in the migration — they must exclude soft-deleted
  // rows, which Prisma cannot express.
  @@index([profile_id])
  @@map("photos")
}

/// Chat media, voice notes, verification documents, and report evidence.
model MediaAsset {
  id       String    @id @default(uuid(4)) @db.Uuid
  owner_id String    @db.Uuid
  kind     MediaKind

  /// Verification documents and report evidence go to a separate private bucket
  /// with stricter lifecycle rules (spec §7, Batch 4).
  s3_bucket String  @db.VarChar(128)
  s3_key    String  @db.VarChar(512)
  url       String? @db.VarChar(2048)

  mime_type  String @db.VarChar(128)
  size_bytes Int

  /// Voice notes and video (spec §5.4: voice notes carry duration).
  duration_ms Int?
  width       Int?
  height      Int?

  moderation_status ModerationStatus @default(pending)

  /// Set once storage confirms the bytes actually arrived (spec §4.8).
  ///
  /// An upload is a two-step handshake: we issue a presigned URL and record the
  /// intent, the client PUTs directly to storage, then we HEAD the object to
  /// see what really landed. Until this is set the row is an intent, not an
  /// asset, and nothing may reference it — the client saying "done" is a claim,
  /// not evidence.
  uploaded_at DateTime?

  created_at DateTime  @default(now())
  deleted_at DateTime?

  owner           User             @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  messages        Message[]
  verifications   Verification[]
  report_evidence ReportEvidence[]

  @@index([owner_id])
  @@index([kind])
  @@map("media_assets")
}

/// spec §7 Batch 4: three methods, three-step wizard, badge derived from the
/// latest approved record.
model Verification {
  id      String @id @default(uuid(4)) @db.Uuid
  user_id String @db.Uuid

  method       VerificationMethod
  status       VerificationStatus @default(pending)
  /// Three-step wizard position, 1..3.
  current_step Int                @default(1)

  asset_id        String? @db.Uuid
  social_provider String? @db.VarChar(32)

  submitted_at     DateTime?
  reviewed_at      DateTime?
  reviewed_by_id   String?   @db.Uuid
  rejection_reason String?   @db.VarChar(500)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user        User        @relation("VerificationSubject", fields: [user_id], references: [id], onDelete: Cascade)
  reviewed_by User?       @relation("VerificationReviewer", fields: [reviewed_by_id], references: [id], onDelete: SetNull)
  asset       MediaAsset? @relation(fields: [asset_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([status])
  @@map("verifications")
}

// ============================================================================
// MODES  (spec §5.2)
// ============================================================================

/// Discovery preferences are stored PER MODE, not once per user. A 3 km radius
/// in Cuddle and a 50 km radius in Networking is normal and must be expressible.
model UserMode {
  id      String @id @default(uuid(4)) @db.Uuid
  user_id String @db.Uuid
  mode    Mode

  is_enabled Boolean @default(false)
  /// Signup picks one primary mode. A partial unique index in the migration
  /// enforces at most one per user.
  is_primary Boolean @default(false)

  // Common preferences are columns (spec §5.2).
  min_age       Int     @default(18)
  max_age       Int     @default(99)
  /// spec §4.6: distance is metres everywhere in this system. The client
  /// formats to miles. Default ~30 miles.
  radius_metres Int     @default(48280)
  verified_only Boolean @default(false)

  /// Mode-specific extras, validated against a per-mode Zod schema in Batch 5:
  /// study_buddy has subject and academic level, dating has relationship goal,
  /// pet_dates has pet type, trading has instrument interests.
  preferences Json @default("{}")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, mode])
  @@index([user_id])
  @@index([mode, is_enabled])
  @@map("user_modes")
}

/// Everything on the Settings and Mode & Privacy screens (spec §7, Batch 5).
///
/// One row per user, created on first read. Kept apart from Profile because
/// none of it is ever shown to another user — a setting cannot leak into a deck
/// card by being added to the wrong model.
model UserSettings {
  id      String @id @default(uuid(4)) @db.Uuid
  user_id String @unique @db.Uuid

  // --- Appearance --------------------------------------------------------
  theme         ThemePreference @default(system)
  /// 1.0 is the system default. Bounded by a CHECK in the migration.
  text_scale    Float           @default(1.0)
  reduce_motion Boolean         @default(false)
  high_contrast Boolean         @default(false)

  // --- Privacy -----------------------------------------------------------
  /// spec §4.6 keeps the API in metres regardless; this is display only.
  distance_unit    DistanceUnit @default(miles)
  show_distance    Boolean      @default(true)
  show_last_active Boolean      @default(true)
  /// Hides the profile from anyone the user has not already matched with.
  incognito        Boolean      @default(false)

  // --- Discovery ---------------------------------------------------------
  /// Global override on top of the per-mode verified_only filter.
  global_verified_only Boolean @default(false)
  /// Stop new matches without hiding the profile or losing existing ones.
  pause_new_matches    Boolean @default(false)

  // --- Account -----------------------------------------------------------
  /// BCP-47. Mirrors the Accept-Language header the app sends (spec §4.11).
  language String @default("en") @db.VarChar(10)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ============================================================================
// DISCOVERY AND MATCHING
// ============================================================================

/// spec §5.3: swipe uniqueness is (actor, target, mode). The same pair can like
/// each other in Study Buddy and pass in Dating, and neither swipe knows about
/// the other. There is no such thing as "have I swiped on X" — only "have I
/// swiped on X in this mode".
///
/// Rewind (spec §5.3) deletes the row rather than flagging it; a flagged row
/// would keep the unique constraint occupied and block re-swiping.
model Swipe {
  id        String      @id @default(uuid(4)) @db.Uuid
  actor_id  String      @db.Uuid
  target_id String      @db.Uuid
  mode      Mode
  action    SwipeAction

  created_at DateTime @default(now())

  actor  User @relation("SwipeActor", fields: [actor_id], references: [id], onDelete: Cascade)
  target User @relation("SwipeTarget", fields: [target_id], references: [id], onDelete: Cascade)

  @@unique([actor_id, target_id, mode])
  /// "Who liked you" (spec §7, Batch 7).
  @@index([target_id, mode, action])
  /// Rewind: the caller's most recent swipe in a mode.
  @@index([actor_id, mode, created_at])
  @@map("swipes")
}

/// spec §1: a match belongs to exactly one mode. Two users can hold several
/// simultaneous matches in different modes — two rows, two conversations, two
/// expiry clocks. Unmatching in Dating leaves Study Buddy untouched.
///
/// user_a_id < user_b_id is enforced by a CHECK constraint in the migration, so
/// a pair cannot hold two matches in one mode with the columns swapped.
model Match {
  id        String @id @default(uuid(4)) @db.Uuid
  user_a_id String @db.Uuid
  user_b_id String @db.Uuid
  mode      Mode

  status        MatchStatus @default(active)
  /// spec §5.3: a super_like counts as a like for matching and is surfaced to
  /// the recipient.
  is_super_like Boolean     @default(false)

  matched_at DateTime @default(now())
  /// spec §5.4: stored explicitly rather than computed. "Extend matches" is a
  /// premium feature, so matches expire by default. The TTL value is open
  /// decision #6; the column exists regardless.
  expires_at DateTime

  extended_at     DateTime?
  extension_count Int       @default(0)

  unmatched_at    DateTime?
  /// Not a foreign key: this always references user_a or user_b, both of which
  /// are already FK-enforced on this row.
  unmatched_by_id String?   @db.Uuid

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user_a       User          @relation("MatchUserA", fields: [user_a_id], references: [id], onDelete: Cascade)
  user_b       User          @relation("MatchUserB", fields: [user_b_id], references: [id], onDelete: Cascade)
  conversation Conversation?
  plans        Plan[]
  calls        CallSession[]

  @@unique([user_a_id, user_b_id, mode])
  @@index([user_a_id, status, mode])
  @@index([user_b_id, status, mode])
  @@index([expires_at])
  @@map("matches")
}

/// spec §5.3: decks are precomputed per user per mode per day so pagination is
/// stable and the ranking algorithm does not re-run on every scroll. The day
/// boundary is UTC, matching the quota reset.
model Deck {
  id      String @id @default(uuid(4)) @db.Uuid
  user_id String @db.Uuid
  mode    Mode

  deck_date    DateTime @db.Date
  generated_at DateTime @default(now())

  user    User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  entries DeckEntry[]

  @@unique([user_id, mode, deck_date])
  @@map("decks")
}

model DeckEntry {
  id        String @id @default(uuid(4)) @db.Uuid
  deck_id   String @db.Uuid
  target_id String @db.Uuid

  position Int
  /// Ranking score. spec §5.3: verified users rank higher — a ranking input,
  /// distinct from the verified_only hard filter on UserMode.
  score    Float @default(0)

  /// spec §4.6: metres. Snapshot at generation time.
  distance_metres Int?
  consumed_at     DateTime?

  deck   Deck @relation(fields: [deck_id], references: [id], onDelete: Cascade)
  target User @relation("DeckEntryTarget", fields: [target_id], references: [id], onDelete: Cascade)

  @@unique([deck_id, target_id])
  @@index([deck_id, position])
  @@map("deck_entries")
}

model Boost {
  id      String @id @default(uuid(4)) @db.Uuid
  user_id String @db.Uuid
  mode    Mode

  started_at DateTime @default(now())
  ends_at    DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, mode])
  @@index([ends_at])
  @@map("boosts")
}

// ============================================================================
// CHAT
// ============================================================================

/// A conversation belongs to a match and inherits its mode, which never changes
/// (spec §5.4). match_id is non-nullable and unique: decision #5 settled that
/// users cannot message before matching, so there is always exactly one match
/// behind a conversation, and decision #11 settled that it has exactly two
/// participants.
model Conversation {
  id       String @id @default(uuid(4)) @db.Uuid
  match_id String @unique @db.Uuid

  /// Denormalised from the match so the chat header and mode-scoped queries do
  /// not need a join. Immutable.
  mode Mode

  last_message_at      DateTime?
  last_message_preview String?   @db.VarChar(200)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  match    Match               @relation(fields: [match_id], references: [id], onDelete: Cascade)
  messages Message[]
  states   ConversationState[]

  @@index([last_message_at])
  @@map("conversations")
}

/// Per-user view of a conversation: archive, mute, read position, unread count.
/// Exactly two rows per conversation (decision #11).
model ConversationState {
  id              String @id @default(uuid(4)) @db.Uuid
  conversation_id String @db.Uuid
  user_id         String @db.Uuid

  is_archived  Boolean   @default(false)
  is_muted     Boolean   @default(false)
  last_read_at DateTime?
  unread_count Int       @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([conversation_id, user_id])
  @@index([user_id, is_archived])
  @@map("conversation_states")
}

model Message {
  id              String      @id @default(uuid(4)) @db.Uuid
  conversation_id String      @db.Uuid
  sender_id       String      @db.Uuid
  type            MessageType @default(text)

  body           String? @db.VarChar(2000)
  media_asset_id String? @db.Uuid
  venue_id       String? @db.Uuid
  /// Voice notes carry duration (spec §5.4).
  duration_ms    Int?

  /// spec §5.4: "review before you send" is advisory, not blocking. When a user
  /// pushes past a scam warning we record it — that is exactly what the
  /// moderation team needs to see later.
  moderation_overridden Boolean @default(false)
  moderation_flagged    Boolean @default(false)

  delivered_at DateTime?
  read_at      DateTime?

  created_at DateTime  @default(now())
  /// spec §7 Batch 1: soft delete where audit matters.
  deleted_at DateTime?

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [sender_id], references: [id], onDelete: Cascade)
  media_asset  MediaAsset?  @relation(fields: [media_asset_id], references: [id], onDelete: SetNull)
  venue        Venue?       @relation(fields: [venue_id], references: [id], onDelete: SetNull)

  /// spec §4.5: messages paginate backwards, newest first.
  @@index([conversation_id, created_at(sort: Desc)])
  @@index([sender_id])
  @@map("messages")
}

// ============================================================================
// SAFETY  (spec §5.5, §5.7)
// ============================================================================

/// Blocks beat everything. A blocked pair must never appear in each other's
/// decks, must not be able to match, and their conversation becomes read-only.
/// Enforced by a single shared exclusion clause reused by every query — indexed
/// in both directions because that clause always checks both.
model Block {
  id         String   @id @default(uuid(4)) @db.Uuid
  blocker_id String   @db.Uuid
  blocked_id String   @db.Uuid
  created_at DateTime @default(now())

  blocker User @relation("Blocker", fields: [blocker_id], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blocked_id], references: [id], onDelete: Cascade)

  @@unique([blocker_id, blocked_id])
  @@index([blocked_id])
  @@map("blocks")
}

/// spec §5.7: reports are anonymous. `reporter_id` exists because moderation and
/// abuse-rate limiting need it, but it must NEVER be exposed through any
/// endpoint, notification, or error message. Anonymity is enforced at the API
/// layer — no serializer may include this column.
model Report {
  id          String       @id @default(uuid(4)) @db.Uuid
  reporter_id String       @db.Uuid
  reported_id String       @db.Uuid
  reason      ReportReason
  description String?      @db.VarChar(1000)

  /// What was reported: "profile" | "message" | "call" | "plan".
  context_type String? @db.VarChar(32)
  context_id   String? @db.Uuid

  /// spec §5.7: optional flag that atomically blocks on submit.
  also_block Boolean @default(false)

  status          ReportStatus @default(open)
  reviewed_by_id  String?      @db.Uuid
  reviewed_at     DateTime?
  resolution_note String?      @db.VarChar(1000)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  reporter    User             @relation("Reporter", fields: [reporter_id], references: [id], onDelete: Cascade)
  reported    User             @relation("Reported", fields: [reported_id], references: [id], onDelete: Cascade)
  reviewed_by User?            @relation("ReportReviewer", fields: [reviewed_by_id], references: [id], onDelete: SetNull)
  evidence    ReportEvidence[]

  @@index([reported_id])
  @@index([reporter_id])
  @@index([status, created_at])
  @@map("reports")
}

model ReportEvidence {
  id             String   @id @default(uuid(4)) @db.Uuid
  report_id      String   @db.Uuid
  media_asset_id String   @db.Uuid
  created_at     DateTime @default(now())

  report      Report     @relation(fields: [report_id], references: [id], onDelete: Cascade)
  media_asset MediaAsset @relation(fields: [media_asset_id], references: [id], onDelete: Cascade)

  @@unique([report_id, media_asset_id])
  @@index([report_id])
  @@map("report_evidence")
}

model TrustedContact {
  id      String @id @default(uuid(4)) @db.Uuid
  user_id String @db.Uuid

  name         String  @db.VarChar(100)
  phone        String? @db.VarChar(32)
  email        String? @db.VarChar(320)
  relationship String? @db.VarChar(64)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user   User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  shares PlanShare[]

  @@index([user_id])
  @@map("trusted_contacts")
}

/// spec §5.7: live location is high-risk data. Explicit start/stop, hard TTL,
/// auto-expire when the plan ends, and no historical trail beyond immediate
/// safety need — a scheduled job purges pings for ended sessions.
model LiveLocationSession {
  id      String  @id @default(uuid(4)) @db.Uuid
  user_id String  @db.Uuid
  plan_id String? @db.Uuid

  started_at DateTime  @default(now())
  expires_at DateTime
  ended_at   DateTime?

  created_at DateTime @default(now())

  user  User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  plan  Plan?              @relation(fields: [plan_id], references: [id], onDelete: SetNull)
  pings LiveLocationPing[]

  @@index([user_id])
  @@index([expires_at])
  @@map("live_location_sessions")
}

model LiveLocationPing {
  id         String @id @default(uuid(4)) @db.Uuid
  session_id String @db.Uuid

  /// PostGIS. Written through raw SQL only.
  location        Unsupported("geography(Point, 4326)")?
  accuracy_metres Int?
  recorded_at     DateTime                               @default(now())

  session LiveLocationSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id, recorded_at])
  @@map("live_location_pings")
}

model EmergencyEvent {
  id      String             @id @default(uuid(4)) @db.Uuid
  user_id String             @db.Uuid
  type    EmergencyEventType

  location    Unsupported("geography(Point, 4326)")?
  note        String?                                @db.VarChar(500)
  resolved_at DateTime?

  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("emergency_events")
}

// ============================================================================
// PLANS AND VENUES  (spec §5.8, §5.9)
// ============================================================================

/// spec §5.8: only participants in an active, non-blocked match may create a
/// plan together. A `draft` is visible only to its creator — the other party
/// sees nothing until it is proposed.
model Plan {
  id         String @id @default(uuid(4)) @db.Uuid
  creator_id String @db.Uuid
  match_id   String @db.Uuid

  venue_id        String? @db.Uuid
  custom_location String? @db.VarChar(200)
  custom_address  String? @db.VarChar(300)

  scheduled_at     DateTime?
  duration_minutes Int?
  status           PlanStatus @default(draft)
  notes            String?    @db.VarChar(1000)

  responded_at        DateTime?
  /// Not a foreign key: always one of the two match participants.
  responded_by_id     String?   @db.Uuid
  cancelled_at        DateTime?
  cancelled_by_id     String?   @db.Uuid
  cancellation_reason String?   @db.VarChar(500)
  completed_at        DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  creator        User                  @relation("PlanCreator", fields: [creator_id], references: [id], onDelete: Cascade)
  match          Match                 @relation(fields: [match_id], references: [id], onDelete: Cascade)
  venue          Venue?                @relation(fields: [venue_id], references: [id], onDelete: SetNull)
  shares         PlanShare[]
  live_locations LiveLocationSession[]

  @@index([match_id, status])
  @@index([creator_id])
  @@index([scheduled_at])
  @@map("plans")
}

model PlanShare {
  id                 String   @id @default(uuid(4)) @db.Uuid
  plan_id            String   @db.Uuid
  trusted_contact_id String   @db.Uuid
  shared_at          DateTime @default(now())

  plan            Plan           @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  trusted_contact TrustedContact @relation(fields: [trusted_contact_id], references: [id], onDelete: Cascade)

  @@unique([plan_id, trusted_contact_id])
  @@index([plan_id])
  @@map("plan_shares")
}

/// spec §7 Batch 12: availability windows. Minutes from midnight rather than a
/// time type — no timezone ambiguity, trivially comparable.
model AvailabilityWindow {
  id      String @id @default(uuid(4)) @db.Uuid
  user_id String @db.Uuid

  /// 0 = Sunday .. 6 = Saturday.
  day_of_week  Int
  start_minute Int
  end_minute   Int

  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("availability_windows")
}

/// spec §5.9: admin-curated, searchable, sorted by distance, filterable by
/// category. Suggestions are tuned to the match's shared mode.
model Venue {
  id          String        @id @default(uuid(4)) @db.Uuid
  name        String        @db.VarChar(150)
  category    VenueCategory
  description String?       @db.VarChar(1000)

  /// PostGIS. Written through raw SQL only; GIST index added in the migration.
  location Unsupported("geography(Point, 4326)")?
  address  String?                                @db.VarChar(300)
  city     String?                                @db.VarChar(120)
  country  String?                                @db.Char(2)

  rating      Float?
  /// 1..4, the usual $-$$$$ scale.
  price_level Int?

  photo_url   String? @db.VarChar(2048)
  website_url String? @db.VarChar(2048)
  phone       String? @db.VarChar(32)

  /// Which modes this venue suits, so suggestions match the conversation's mode.
  modes     Mode[]
  is_active Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  saved_by SavedVenue[]
  plans    Plan[]
  messages Message[]

  @@index([category])
  @@index([city])
  @@map("venues")
}

model SavedVenue {
  id         String   @id @default(uuid(4)) @db.Uuid
  user_id    String   @db.Uuid
  venue_id   String   @db.Uuid
  created_at DateTime @default(now())

  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venue_id], references: [id], onDelete: Cascade)

  @@unique([user_id, venue_id])
  @@index([user_id])
  @@map("saved_venues")
}

// ============================================================================
// MONEY  (spec §5.10, §5.11)
// ============================================================================

/// Deliberately named SubscriptionProduct to avoid collision with date-Plans.
/// The catalogue the paywall renders (spec §5.10). Store identifiers are here
/// so a purchase reported by a store can be matched back to a product; the
/// backend never charges anyone itself.
model SubscriptionProduct {
  id   String @id @default(uuid(4)) @db.Uuid
  slug String @unique @db.VarChar(64)
  name String @db.VarChar(100)

  tier          SubscriptionTier
  billing_cycle BillingCycle

  apple_product_id  String? @unique @db.VarChar(128)
  google_product_id String? @unique @db.VarChar(128)

  is_active  Boolean @default(true)
  sort_order Int     @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  subscriptions  Subscription[]
  price_versions PriceVersion[]

  @@unique([tier, billing_cycle])
  @@map("subscription_products")
}

/// spec §5.10: entitlement belongs to the USER, never the device or the store
/// account. Subscribing on iOS then signing in on Android must carry over —
/// that is exactly what this user_id relation guarantees.
model Subscription {
  id         String @id @default(uuid(4)) @db.Uuid
  user_id    String @db.Uuid
  product_id String @db.Uuid

  status SubscriptionStatus
  source PaymentSource

  store_transaction_id    String? @db.VarChar(256)
  /// Stable across renewals — the key both stores use to identify a
  /// subscription's whole life.
  original_transaction_id String? @db.VarChar(256)
  store_purchase_token    String?

  current_period_start DateTime
  current_period_end   DateTime
  auto_renew           Boolean  @default(true)

  cancelled_at DateTime?
  expired_at   DateTime?
  refunded_at  DateTime?
  revoked_at   DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user    User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product SubscriptionProduct @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@unique([source, original_transaction_id])
  @@index([user_id, status])
  @@index([current_period_end])
  @@map("subscriptions")
}

/// spec §5.10: effective-dated price records for reporting and grandfathering.
/// INFORMATIONAL ONLY for store purchases — Apple and Google own the actual
/// charge. The backend can record price history; it cannot change what a user
/// is charged. This is open decision #3.
model PriceVersion {
  id         String @id @default(uuid(4)) @db.Uuid
  product_id String @db.Uuid

  /// spec §4.6: integer minor units plus currency. Never floats.
  amount_minor Int
  currency     String @db.Char(3)

  effective_from DateTime
  effective_to   DateTime?
  source         PaymentSource?
  note           String?        @db.VarChar(500)

  created_at DateTime @default(now())

  product SubscriptionProduct @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id, effective_from])
  @@map("price_versions")
}

/// spec §5.11: build the entitlement system so the matrix is DATA, NOT CODE.
/// Filling in an undecided cell later must be a seed change, never a code change.
model EntitlementFlag {
  id          String  @id @default(uuid(4)) @db.Uuid
  key         String  @unique @db.VarChar(64)
  label       String  @db.VarChar(100)
  description String? @db.VarChar(300)
  /// "boolean" | "number" — a number of -1 means unlimited.
  value_type  String  @db.VarChar(16)

  created_at DateTime @default(now())

  tiers TierEntitlement[]

  @@map("entitlement_flags")
}

model TierEntitlement {
  id      String           @id @default(uuid(4)) @db.Uuid
  tier    SubscriptionTier
  flag_id String           @db.Uuid
  value   Json

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  flag EntitlementFlag @relation(fields: [flag_id], references: [id], onDelete: Cascade)

  @@unique([tier, flag_id])
  @@map("tier_entitlements")
}

/// spec §5.10: store server notifications are the source of truth, not the
/// client. Both stores retry, and duplicates are routine — the unique index is
/// what makes processing idempotent.
model StoreNotification {
  id     String        @id @default(uuid(4)) @db.Uuid
  source PaymentSource

  notification_id   String  @db.VarChar(256)
  notification_type String? @db.VarChar(64)

  payload            Json
  /// Apple's JWS signature / Google's Pub/Sub authenticity check.
  signature_verified Boolean @default(false)

  processed_at DateTime?
  error        String?   @db.VarChar(1000)

  created_at DateTime @default(now())

  @@unique([source, notification_id])
  @@index([processed_at])
  @@map("store_notifications")
}

/// spec §4.10: Idempotency-Key on subscription purchase, report submission, and
/// plan creation. Store the key with its response for 24h and replay on repeat —
/// mobile networks retry, and without this you get double charges.
model IdempotencyKey {
  id      String @id @default(uuid(4)) @db.Uuid
  user_id String @db.Uuid

  key          String @db.VarChar(255)
  endpoint     String @db.VarChar(255)
  request_hash String @db.VarChar(64)

  response_status Int?
  response_body   Json?

  created_at DateTime @default(now())
  expires_at DateTime

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, endpoint, key])
  @@index([expires_at])
  @@map("idempotency_keys")
}

// ============================================================================
// NOTIFICATIONS  (spec §7, Batch 11)
// ============================================================================

/// Every notification is persisted here AND pushed. The Notifications screen
/// reads this feed, so a push-only notification silently disappears.
model Notification {
  id       String               @id @default(uuid(4)) @db.Uuid
  user_id  String               @db.Uuid
  category NotificationCategory

  title String @db.VarChar(150)
  body  String @db.VarChar(500)
  /// Deep-link payload the app uses to route on tap.
  data  Json   @default("{}")

  read_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at(sort: Desc)])
  @@index([user_id, read_at])
  @@map("notifications")
}

model NotificationPreference {
  id       String               @id @default(uuid(4)) @db.Uuid
  user_id  String               @db.Uuid
  category NotificationCategory

  push_enabled   Boolean @default(true)
  email_enabled  Boolean @default(false)
  in_app_enabled Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, category])
  @@map("notification_preferences")
}

// ============================================================================
// CALLS  (spec §7, Batch 14)
// ============================================================================

model CallSession {
  id           String @id @default(uuid(4)) @db.Uuid
  match_id     String @db.Uuid
  initiator_id String @db.Uuid

  /// Tokens are scoped to this room and short-lived. Never issue a token that
  /// grants access to arbitrary rooms.
  room_name String     @unique @db.VarChar(128)
  status    CallStatus @default(ringing)

  started_at       DateTime?
  answered_at      DateTime?
  ended_at         DateTime?
  duration_seconds Int?
  /// Not a foreign key: always one of the two match participants.
  ended_by_id      String?   @db.Uuid

  created_at DateTime @default(now())

  match          Match              @relation(fields: [match_id], references: [id], onDelete: Cascade)
  initiator      User               @relation("CallInitiator", fields: [initiator_id], references: [id], onDelete: Cascade)
  safety_actions CallSafetyAction[]

  @@index([match_id])
  @@index([initiator_id])
  @@map("call_sessions")
}

/// spec §5.7: in-call safety actions — flag, end-and-report, send live update.
model CallSafetyAction {
  id      String               @id @default(uuid(4)) @db.Uuid
  call_id String               @db.Uuid
  user_id String               @db.Uuid
  action  CallSafetyActionType
  note    String?              @db.VarChar(500)

  created_at DateTime @default(now())

  call CallSession @relation(fields: [call_id], references: [id], onDelete: Cascade)
  user User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([call_id])
  @@map("call_safety_actions")
}

// ============================================================================
// MODERATION  (spec §5.4, §7 Batch 10)
// ============================================================================

/// The result of a pre-send check. spec §5.4: if the provider times out we fail
/// open — allow the send and flag for async review. `timed_out` records that.
model ModerationCheck {
  id      String @id @default(uuid(4)) @db.Uuid
  user_id String @db.Uuid

  /// "message" | "bio" | "prompt_answer" | "photo"
  subject_type String  @db.VarChar(32)
  subject_id   String? @db.Uuid

  content_hash String @db.VarChar(64)
  provider     String @db.VarChar(64)

  severity     ModerationSeverity @default(none)
  categories   Json               @default("[]")
  raw_response Json?

  /// spec §5.4: a user pushing past a scam warning is exactly what the
  /// moderation team needs to see later.
  was_overridden Boolean @default(false)
  timed_out      Boolean @default(false)

  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([severity])
  @@map("moderation_checks")
}

/// The moderation team's work queue. Distinct from Report: reports come from
/// users, flags come from the system.
model ModerationFlag {
  id           String @id @default(uuid(4)) @db.Uuid
  subject_type String @db.VarChar(32)
  subject_id   String @db.Uuid

  reason   String             @db.VarChar(200)
  severity ModerationSeverity @default(low)
  status   ReportStatus       @default(open)

  /// Not a foreign key: an admin user id, kept loose so deleting a staff
  /// account never blocks queue cleanup.
  assigned_to_id String?   @db.Uuid
  resolved_at    DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status, severity])
  @@index([subject_type, subject_id])
  @@map("moderation_flags")
}

// ============================================================================
// ADMIN  (spec §7, Batch 15)
// ============================================================================

/// Audit log for every admin action — who did what to whom, when.
model AdminAuditLog {
  id       String @id @default(uuid(4)) @db.Uuid
  admin_id String @db.Uuid

  action      String  @db.VarChar(64)
  target_type String  @db.VarChar(32)
  target_id   String? @db.Uuid

  metadata   Json    @default("{}")
  ip_address String? @db.VarChar(45)

  created_at DateTime @default(now())

  admin User @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@index([admin_id, created_at])
  @@index([target_type, target_id])
  @@map("admin_audit_logs")
}
